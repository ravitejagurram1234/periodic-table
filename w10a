package com.socgen.sgs.api.quark.engine.infra.interop.qxps.exception;

import com.socgen.sgs.api.quark.engine.infra.interop.qxps.model.QxpsRequestInfo;
import lombok.Getter;

@Getter
public class QxpsException extends RuntimeException {

    private final QxpsRequestInfo requestInfo;
    private final Integer httpStatus;
    private final int responseBodyBytes;

    /** Compatibility boundary: supplied text is deliberately not copied because it may be a payload. */
    public QxpsException(QxpsRequestInfo requestInfo, String message) {
        super(safeMessage(requestInfo, null, message == null ? 0 : message.length()));
        this.requestInfo = requestInfo;
        this.httpStatus = null;
        this.responseBodyBytes = message == null ? 0 : message.length();
    }

    public QxpsException(QxpsRequestInfo requestInfo, int httpStatus, int responseBodyBytes) {
        super(safeMessage(requestInfo, httpStatus, responseBodyBytes));
        this.requestInfo = requestInfo;
        this.httpStatus = httpStatus;
        this.responseBodyBytes = responseBodyBytes;
    }

    private static String safeMessage(QxpsRequestInfo requestInfo, Integer status, int bodyBytes) {
        String method = requestInfo == null || requestInfo.getMethod() == null
                ? "UNKNOWN" : requestInfo.getMethod().name();
        String path = requestInfo == null || requestInfo.getUri() == null
                ? "<unknown>" : requestInfo.getUri().getPath();
        int queryCount = requestInfo == null || requestInfo.getUri() == null
                || requestInfo.getUri().getRawQuery() == null
                || requestInfo.getUri().getRawQuery().isEmpty()
                ? 0 : requestInfo.getUri().getRawQuery().split("&", -1).length;
        return "QXPS call failed: method=" + method + ", path=" + path
                + ", queryParameterCount=" + queryCount
                + (status == null ? "" : ", httpStatus=" + status)
                + ", responseBodyBytes=" + bodyBytes;
    }
}

